{
  "name": "pel-26",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:production": "astro check && astro build --mode production",
    "preview": "astro preview",
    "preview:production": "astro preview --host 0.0.0.0",
    "deploy": "./deploy.sh production",
    "deploy:staging": "./deploy.sh staging",
    "deploy:build": "./deploy.sh production --auto-build",
    "deploy:build:staging": "./deploy.sh staging --auto-build",
    "deploy:quick": "./deploy.sh production --auto-build --no-package",
    "deploy:quick:staging": "./deploy.sh staging --auto-build --no-package",
    "clean": "rm -rf dist/ deploy-package/ *.tar.gz",
    "list:packages": "ls -lh *.tar.gz 2>/dev/null || echo 'No hay paquetes de despliegue'",
    "setup:deploy": "cp deploy.config.example deploy.config && echo 'Archivo deploy.config creado. Editalo con tus datos.'"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.3.14",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource-variable/roboto-condensed": "^5.3.0",
    "astro": "^5.12.3",
    "gsap": "^3.13.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3"
  }
}
