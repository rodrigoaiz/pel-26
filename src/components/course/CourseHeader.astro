---
import Container from '../ui/Container.astro';
import ThemeToggle from '../ThemeToggle.astro';

const base = import.meta.env.BASE_URL;
const { courseName = 'Francés I', coursePath = 'frances-1' } = Astro.props;
---

<header class="sticky top-0 z-30 border-b border-border/80 bg-surface/95 backdrop-blur-md">
  <Container class="flex min-h-16 items-center justify-between gap-4 py-2">
    <a class="group inline-flex min-w-0 items-center gap-3 no-underline" href={`${base}${coursePath}/`} aria-label={`Inicio de ${courseName}`}>
      <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-navy font-display text-xl font-black text-on-navy transition group-hover:bg-navy-soft">F</span>
      <span class="min-w-0">
        <strong class="block truncate font-display text-lg leading-none">{courseName}</strong>
        <span class="mt-1 block text-xs font-semibold text-muted">Plan de estudios actualizado</span>
      </span>
    </a>
    <div class="flex items-center gap-2">
      <a class="hidden min-h-10 items-center rounded-xl px-3 text-sm font-bold text-muted no-underline transition hover:bg-secondary-soft hover:text-secondary sm:inline-flex" href="/?theme=moove">Mis cursos</a>
      <ThemeToggle />
    </div>
  </Container>
</header>
