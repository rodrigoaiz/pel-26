---
import Container from '../ui/Container.astro';
import ArrowIcon from '../ui/ArrowIcon.astro';
import type { CourseUnit } from '../../data/courses/frances-3';

interface Props {
  units: CourseUnit[];
  basePath: string;
}

const { units, basePath } = Astro.props;
---

<section class="py-14 sm:py-20" aria-labelledby="index-title">
  <Container>
    <div class="grid gap-5 border-b border-border pb-8 lg:grid-cols-[.75fr_1.25fr] lg:items-end">
      <div>
        <p class="m-0 text-xs font-bold uppercase tracking-[.18em] text-secondary">Mapa de trabajo</p>
        <h2 id="index-title" class="mt-3 max-w-lg text-4xl font-black leading-none tracking-section sm:text-5xl">Índice tentativo</h2>
      </div>
      <p class="m-0 max-w-2xl text-base leading-7 text-muted lg:justify-self-end">
        Esta propuesta organiza el curso mientras se define el contenido definitivo. Las unidades y temas podrán cambiar durante la planeación.
      </p>
    </div>

    <ol class="m-0 list-none divide-y divide-border p-0">
      {units.map((unit, index) => (
        <li class="group grid gap-6 py-8 lg:grid-cols-[4rem_.8fr_1.2fr_auto] lg:items-start">
          <span class="grid size-11 place-items-center rounded-full border border-border font-display text-xl font-bold text-secondary">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="m-0 text-3xl font-black leading-none">{unit.title}</h3>
            <p class="mt-2 text-sm font-semibold text-muted">{unit.theme}</p>
          </div>
          <ul class="m-0 grid list-none gap-2 p-0 text-sm text-muted sm:grid-cols-2">
            {unit.topics.map((topic) => <li class="border-l-2 border-secondary-soft pl-3">{topic}</li>)}
          </ul>
          <a class="inline-flex min-h-11 items-center gap-2 self-center text-sm font-bold text-primary no-underline transition hover:gap-3 hover:text-primary-hover" href={`${basePath}/${unit.id}/`}>
            Ver unidad <ArrowIcon class="size-4" />
          </a>
        </li>
      ))}
    </ol>
  </Container>
</section>
