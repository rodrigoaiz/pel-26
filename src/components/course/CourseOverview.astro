---
import CourseHero from './CourseHero.astro';
import UnitList from './UnitList.astro';
import type { Course } from '@/data/courses/types';
import type { getCourseNavigation } from '@/data/courses/navigation';

interface Props {
  course: Course;
  navigation: ReturnType<typeof getCourseNavigation>;
}

const { course, navigation } = Astro.props;
const learningCount = Object.values(navigation.learningGroupsByUnit).reduce((count, groups) => count + groups.length, 0);
---

<main>
  <CourseHero
    title={course.heroTitle}
    description={course.description}
    courseSlug={course.slug}
    ctaLabel={`Empezar por la ${navigation.units[0]?.title ?? 'Unidad 1'}`}
    ctaHref={navigation.firstLessonHref}
    progressLabel={`${navigation.units.length} unidades · ${learningCount} aprendizajes · ${navigation.screens.length} pantallas`}
  />
  <UnitList
    units={navigation.units}
    currentLessons={navigation.currentLessons}
    lessonsByUnit={navigation.lessonsByUnit}
    learningGroupsByUnit={navigation.learningGroupsByUnit}
    coursePath={course.slug}
    featuredUnitId={navigation.featuredUnitId}
    featuredHref={navigation.firstLessonHref}
    bilingual={course.bilingual}
  />
</main>
