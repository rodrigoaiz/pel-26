---
import type { Lesson } from '../../data/course';
import Container from '../ui/Container.astro';
import ArrowIcon from '../ui/ArrowIcon.astro';

interface Unit {
  id: string;
  title: string;
  theme: string;
  lessons: number;
}

interface Props {
  units: Unit[];
  currentLessons: Lesson[];
}

const { units, currentLessons } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<section class="py-16 sm:py-20" aria-labelledby="units-title">
  <Container>
    <div class="grid gap-6 border-b border-border pb-8 lg:grid-cols-[.8fr_1.2fr] lg:items-end">
      <h2 id="units-title" class="m-0 max-w-lg font-display text-4xl font-black leading-none tracking-[-.02em] sm:text-5xl">Tu mapa para avanzar</h2>
      <p class="m-0 max-w-2xl text-base leading-7 text-muted lg:justify-self-end">
        Cada unidad reúne situaciones que puedes usar fuera de la pantalla. Entra a la lección actual o revisa el camino completo.
      </p>
    </div>

    <ol class="m-0 list-none p-0">
      {units.map((unit, index) => unit.id === 'u2' ? (
        <li class="my-6 overflow-hidden rounded-panel bg-navy text-on-navy shadow-raised">
          <div class="grid gap-8 p-6 sm:p-8 lg:grid-cols-2 lg:p-10">
            <div>
              <div class="flex items-center gap-3 text-sm font-bold text-secondary">
                <span class="grid size-9 place-items-center rounded-full bg-secondary text-navy">{index + 1}</span>
                <span>Recorrido disponible</span>
              </div>
              <h3 class="mt-6 text-4xl font-black leading-none sm:text-5xl">{unit.title}</h3>
              <p class="mt-3 text-lg text-on-navy/70">{unit.theme}</p>
              <a class="mt-7 inline-flex min-h-11 items-center gap-3 rounded-xl bg-primary px-4 py-2.5 text-sm font-bold text-on-primary no-underline transition hover:-translate-y-0.5 hover:bg-primary-hover" href={`${base}frances-1/unidad-2/mon-age/`}>
                Entrar a la unidad <ArrowIcon />
              </a>
            </div>
            <div class="border-t border-on-navy/15 pt-6 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
              <p class="m-0 text-xs font-bold uppercase tracking-widest text-on-navy/55">Itinerario · {unit.lessons} lecciones</p>
              <ol class="mt-3 list-none p-0">
                {currentLessons.slice(0, 4).map((lesson, lessonIndex) => (
                  <li class="border-t border-on-navy/15 first:border-t-0">
                    <a class:list={[
                      'grid grid-cols-[2rem_1fr_auto] items-center gap-3 py-3 text-sm no-underline transition hover:text-secondary',
                      lessonIndex === 0 ? 'font-bold text-secondary' : 'text-on-navy/78'
                    ]} href={lessonIndex === 0 ? `${base}frances-1/unidad-2/mon-age/` : '#proximamente'}>
                      <span class="text-on-navy/45">{String(lessonIndex + 1).padStart(2, '0')}</span>
                      <span>{lesson.title}</span>
                      {lessonIndex === 0 ? <span class="text-xs">Actual</span> : <ArrowIcon class="size-4" />}
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </li>
      ) : (
        <li class="border-b border-border">
          <a class="group grid min-h-24 grid-cols-[2.5rem_1fr_auto] items-center gap-4 py-5 no-underline sm:grid-cols-[3rem_1fr_auto_auto]" href="#proximamente" aria-label={`${unit.title}: ${unit.theme}`}>
            <span class="grid size-10 place-items-center rounded-full border border-border text-sm font-bold text-muted transition group-hover:border-secondary group-hover:text-secondary">{index + 1}</span>
            <span>
              <strong class="block font-display text-2xl leading-none">{unit.title}</strong>
              <span class="mt-1 block text-sm text-muted">{unit.theme}</span>
            </span>
            <span class="hidden text-sm font-semibold text-muted sm:block">{unit.lessons} lecciones</span>
            <ArrowIcon class="size-5 text-primary transition group-hover:translate-x-1" />
          </a>
        </li>
      ))}
    </ol>

    <div class="mt-10 grid gap-4 border-t border-dashed border-border pt-6 sm:grid-cols-[auto_1fr] sm:items-start">
      <span class="grid size-10 place-items-center rounded-xl bg-secondary-soft text-secondary" aria-hidden="true">
        <svg class="size-5" viewBox="0 0 24 24" fill="none"><path d="M6 4h12v16H6zM9 8h6M9 12h6M9 16h3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
      </span>
      <p class="m-0 max-w-3xl text-sm leading-6 text-muted">
        Las actividades calificadas, foros y entregas permanecen en <strong class="text-foreground">Moodle</strong>. El recorrido te avisa cuándo entrar y conserva una salida clara para volver a la lección.
      </p>
    </div>
  </Container>
</section>
