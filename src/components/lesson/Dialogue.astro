---
interface DialogueLine {
  speaker: string;
  text: string;
}

interface Props {
  lines: DialogueLine[];
}

const { lines } = Astro.props;
---

<div class="grid gap-3" aria-label="Diálogo entre Max y Chloé">
  {lines.map((line) => {
    const isMax = line.speaker === 'Max';
    return (
      <p class:list={[
        'm-0 grid w-full max-w-xl gap-1 rounded-card px-4 py-3 sm:px-5 sm:py-4',
        isMax ? 'justify-self-end bg-warm-soft' : 'bg-secondary-soft'
      ]}>
        <strong class:list={['text-xs uppercase tracking-widest', isMax ? 'text-primary' : 'text-secondary']}>{line.speaker}</strong>
        <span class="text-base leading-7 sm:text-lg">{line.text}</span>
      </p>
    );
  })}
</div>
