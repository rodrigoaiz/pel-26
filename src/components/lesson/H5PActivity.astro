---
import Container from '@/components/ui/Container.astro';
import ArrowIcon from '@/components/ui/ArrowIcon.astro';
import { h5pPath } from '@/utils/resource-path';

interface Props {
  file: string;
  title: string;
  description: string;
  descriptionEn?: string;
  nextHref?: string;
  nextLabel?: string;
  variant?: 1 | 2;
}

const { file, title, description, descriptionEn, nextHref, nextLabel, variant = 1 } = Astro.props;
const src = h5pPath(file);
const bgColor = variant === 1 ? 'bg-navy' : 'bg-slate-900';
---

<section class:list={['relative left-1/2 w-screen -translate-x-1/2 py-14 text-on-navy sm:py-18', bgColor]} data-reveal>
  <Container>
    <div>
      <h2 class="max-w-4xl font-display text-3xl font-bold leading-none tracking-section sm:text-4xl">{title}</h2>
      <div class="mt-4 max-w-4xl">
        <p class="m-0 text-base font-semibold leading-7 text-on-navy">{description}</p>
        {descriptionEn && <p class="m-0 mt-2 text-sm leading-6 text-on-navy/60">{descriptionEn}</p>}
      </div>
    </div>
    <div class="mt-8 overflow-hidden rounded-panel bg-white p-3 shadow-raised sm:p-4">
      <iframe class="block h-course-hero w-full border-0 sm:h-course-hero-lg" title={`Actividad H5P: ${title}`} src={src} loading="lazy" allowfullscreen></iframe>
    </div>
    {nextHref && nextLabel && <a class="mt-7 inline-flex min-h-11 items-center gap-3 font-bold text-primary no-underline transition hover:gap-4 hover:text-primary-hover" href={nextHref}>{nextLabel}<ArrowIcon direction="down" /></a>}
  </Container>
</section>
