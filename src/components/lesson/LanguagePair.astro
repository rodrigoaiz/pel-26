---
interface Props {
  question: string;
  answer: string;
}

const { question, answer } = Astro.props;
---

<div class="mt-6 grid gap-4 sm:grid-cols-2">
  <div class="border-t border-border pt-4"><strong class="text-xs uppercase tracking-widest text-secondary">Pregunta</strong><p class="mb-0 mt-2 font-display text-2xl font-bold">{question}</p></div>
  <div class="border-t border-border pt-4"><strong class="text-xs uppercase tracking-widest text-secondary">Respuesta</strong><p class="mb-0 mt-2 font-display text-2xl font-bold">{answer}</p></div>
</div>
