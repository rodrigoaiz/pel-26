---
import ArrowIcon from '@/components/ui/ArrowIcon.astro';
import { sitePath } from '@/utils/site-path';

const { coursePath = 'frances-1', prevHref, prevLabel, nextHref, nextLabel } = Astro.props;
const linkClass = 'flex min-h-14 items-center gap-3 rounded-xl px-4 py-2 no-underline transition';
---

<footer class="border-t border-border">
  <nav class="grid gap-3 py-8 sm:grid-cols-2" aria-label="Pantalla anterior y siguiente">
    {prevHref ? <a class:list={[linkClass, 'border border-border hover:border-secondary hover:bg-secondary-soft hover:text-secondary']} href={prevHref}>
      <ArrowIcon direction="left" />
      <span><span class="block text-xs font-bold uppercase tracking-widest text-muted">Anterior</span><span class="font-bold">{prevLabel}</span></span>
    </a> : <a class:list={[linkClass, 'font-bold hover:bg-secondary-soft hover:text-secondary']} href={sitePath(`${coursePath}/`)}><ArrowIcon direction="left" />Ver todas las unidades</a>}
    {nextHref && <a class:list={[linkClass, 'justify-between bg-primary text-on-primary hover:bg-primary-hover sm:col-start-2']} href={nextHref}>
      <span><span class="block text-xs font-bold uppercase tracking-widest opacity-80">Siguiente</span><span class="font-bold">{nextLabel}</span></span>
      <ArrowIcon />
    </a>}
  </nav>

  <div class="flex flex-col gap-4 border-t border-border/70 py-6 text-xs leading-5 text-muted sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-3">
      <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-navy font-display text-[10px] font-black tracking-wide text-on-navy" aria-hidden="true">PEL</span>
      <p class="m-0"><strong class="text-foreground">Francés · Programas de Estudio en Línea</strong><span class="hidden sm:inline"> · CCH · UNAM</span></p>
    </div>
    <nav class="flex gap-4 font-semibold" aria-label="Enlaces institucionales">
      <a class="text-muted no-underline transition hover:text-secondary" href="https://portalacademico.cch.unam.mx/aviso-legal">Aviso legal</a>
      <a class="text-muted no-underline transition hover:text-secondary" href="https://www.cch.unam.mx/calendario-escolar">Calendario</a>
    </nav>
  </div>
</footer>
