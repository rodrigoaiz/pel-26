---
import Container from '../ui/Container.astro';
import ArrowIcon from '../ui/ArrowIcon.astro';

interface Props {
  title: string;
  unitLabel?: string;
  progressLabel?: string;
  description?: string;
  firstSectionId?: string;
  phrase?: string;
  translation?: string;
}

const {
  title,
  unitLabel = 'Unidad 2',
  progressLabel = 'Lección 1 de 9',
  description = 'Aprende a preguntar y decir tu edad y tu fecha de nacimiento en una conversación cotidiana.',
  firstSectionId = 'dialogue',
  phrase = 'J’ai quinze ans.',
  translation = 'Yo tengo quince años.'
} = Astro.props;
---

<section id="inicio" class="overflow-hidden border-b border-border bg-surface" data-hero>
  <Container class="grid gap-10 py-12 sm:py-16 lg:grid-cols-[1.2fr_.8fr] lg:items-end lg:py-20">
    <div>
      <div class="flex items-center gap-3 text-sm font-bold text-secondary">
        <span>{unitLabel}</span><span class="size-1 rounded-full bg-primary" aria-hidden="true"></span><span>{progressLabel}</span>
      </div>
       <div class="mt-5 h-1.5 overflow-hidden rounded-full bg-secondary-soft" aria-label={`Progreso de la unidad: ${progressLabel}`}>
         <span class="block h-full w-1/3 rounded-full bg-primary"></span>
      </div>
      <h1 class="mt-7 max-w-3xl font-display text-5xl font-black leading-title tracking-display sm:text-6xl lg:text-7xl">{title}</h1>
       <p class="mt-5 max-w-2xl text-base leading-7 text-muted sm:text-lg">{description}</p>
       <a class="mt-7 inline-flex min-h-11 items-center gap-3 rounded-xl font-bold text-primary no-underline transition hover:gap-4 hover:text-primary-hover" href={`#${firstSectionId}`}>Empezar con la lección <ArrowIcon direction="down" /></a>
    </div>
    <div class="relative overflow-hidden rounded-panel bg-warm-soft p-6 sm:p-8">
      <span class="absolute -right-7 -top-7 size-24 rounded-full border-2 border-primary/35" aria-hidden="true"></span>
      <p class="m-0 text-xs font-bold uppercase tracking-widest text-primary">Frase que vas a dominar</p>
       <p class="mt-8 font-display text-4xl font-black leading-none sm:text-5xl">{phrase}</p>
       <p class="mb-0 mt-3 text-sm font-semibold text-muted">{translation}</p>
    </div>
  </Container>
</section>
