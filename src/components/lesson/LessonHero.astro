---
import Container from '@/components/ui/Container.astro';

interface Props {
  title: string;
  unitLabel: string;
  unitTitle: string;
  learningLabel: string;
}

const { title, unitLabel, unitTitle, learningLabel } = Astro.props;
---

<header id="inicio" class="border-b border-border bg-surface" data-lesson-heading>
  <Container class="py-6 sm:py-8">
    <nav aria-label="Ubicación">
      <ol class="m-0 flex list-none flex-wrap items-center gap-x-2 gap-y-1 p-0 text-sm font-semibold text-muted">
        <li>{unitLabel} · {unitTitle}</li>
        <li aria-hidden="true">›</li>
        <li>{learningLabel}</li>
      </ol>
    </nav>
    <h1 class="mt-3 max-w-4xl font-display text-3xl font-black leading-title tracking-display sm:text-4xl">{title}</h1>
  </Container>
</header>
