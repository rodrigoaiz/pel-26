---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import LessonHeader from './LessonHeader.astro';
import LessonIndex from './LessonIndex.astro';
import LessonHero from './LessonHero.astro';
import LessonFooter from './LessonFooter.astro';
import ActivityViewer from './ActivityViewer.astro';
import LessonIndexController from './LessonIndexController.astro';
import { getLessonNavigation } from '@/data/courses/navigation';
import type { Course } from '@/data/courses/types';

interface Props {
  course: Course;
  entry: CollectionEntry<'lessons'>;
  entries: CollectionEntry<'lessons'>[];
}

const { course, entry, entries } = Astro.props;
const { Content } = await render(entry);
const navigation = getLessonNavigation(entries, entry, course);
const unitLabel = `Unidad ${entry.data.unit.order}`;
const learningLabel = `Aprendizaje ${entry.data.learning.order}`;
---

<BaseLayout title={`${entry.data.title} · ${course.title}`} description={entry.data.subtitle}>
  <main class="min-h-screen bg-background" data-lesson-root>
    <LessonHeader coursePath={course.slug} courseName={course.title} screens={navigation.learningScreens} position={navigation.screenPosition} learningLabel={learningLabel} />
    <LessonIndex
      currentSlug={navigation.currentSlug}
      currentLearningId={entry.data.learning.id}
      unitLabel={unitLabel}
      unitTitle={entry.data.unit.title}
      learningGroups={navigation.learningGroups}
      unitLinks={navigation.unitLinks}
      bilingual={course.bilingual}
    />
    <article>
      <LessonHero
        title={entry.data.title}
        unitLabel={unitLabel}
        unitTitle={entry.data.unit.title}
        learningLabel={learningLabel}
      />
      <Content />
      <Container>
        <LessonFooter
          coursePath={course.slug}
          prevHref={navigation.prevLesson?.href}
          prevLabel={navigation.prevLesson?.title}
          nextHref={navigation.nextLesson?.href}
          nextLabel={navigation.nextLesson?.title}
        />
      </Container>
    </article>
    <ActivityViewer />
  </main>
  <LessonIndexController />
  <script is:inline define:vars={{ key: `pel:last:${course.slug}`, last: { href: Astro.url.pathname, label: `${unitLabel} · ${learningLabel} · Pantalla ${navigation.screenPosition}` } }}>
    try { localStorage.setItem(key, JSON.stringify(last)); } catch {}
  </script>
</BaseLayout>
