---
import Container from '@/components/ui/Container.astro';

interface Props {
  id?: string;
  phase?: string;
  title?: string;
  intro?: string;
  tone?: 'default' | 'soft';
  fullWidth?: boolean;
}

const { id, phase, title, intro, tone = 'default', fullWidth = false } = Astro.props;
---

<section id={id} class:list={['border-b border-border py-10 sm:py-12', tone === 'soft' ? 'bg-surface' : 'bg-background']} data-reveal>
  <Container>
    {(phase || title) && (
      <div class="grid gap-6 lg:grid-cols-[10rem_1fr] lg:gap-10">
        <div>
          {phase && <span class="inline-flex min-h-8 items-center rounded-lg bg-secondary-soft px-3 text-xs font-bold uppercase tracking-widest text-secondary">{phase}</span>}
        </div>
        <div class="min-w-0">
          {title && <h2 class="m-0 text-wrap font-display text-4xl font-black leading-none tracking-section sm:text-5xl">{title}</h2>}
          {intro && <p class="mt-4 max-w-prose text-base leading-7 text-muted">{intro}</p>}
        </div>
      </div>
    )}
    <div class:list={['lesson-content mt-6 w-full lg:mt-8', fullWidth ? 'w-full' : 'mx-auto']}>
      <slot />
    </div>
  </Container>
</section>

<style>
  .lesson-content :global(> p),
  .lesson-content :global(> ul),
  .lesson-content :global(> ol),
  .lesson-content :global(> h1),
  .lesson-content :global(> h2),
  .lesson-content :global(> h3),
  .lesson-content :global(> h4),
  .lesson-content :global(> h5),
  .lesson-content :global(> h6) {
    width: min(100%, 65ch);
    max-width: 65ch;
    margin-inline: auto;
  }

  :global(.w-full) .lesson-content :global(> p),
  :global(.w-full) .lesson-content :global(> ul),
  :global(.w-full) .lesson-content :global(> ol),
  :global(.w-full) .lesson-content :global(> h1),
  :global(.w-full) .lesson-content :global(> h2),
  :global(.w-full) .lesson-content :global(> h3),
  :global(.w-full) .lesson-content :global(> h4),
  :global(.w-full) .lesson-content :global(> h5),
  :global(.w-full) .lesson-content :global(> h6) {
    width: 100%;
    max-width: 100%;
    margin-inline: auto;
  }

  .lesson-content :global(> h1),
  .lesson-content :global(> h2),
  .lesson-content :global(> h3),
  .lesson-content :global(> h4),
  .lesson-content :global(> h5),
  .lesson-content :global(> h6) {
    width: min(100%, 42rem);
    max-width: 42rem;
    margin-inline: auto;
    margin-bottom: 0.75rem;
    color: var(--pel-foreground);
  }

  .lesson-content :global(> h1) {
    margin-top: 1.75rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 0.98;
    font-weight: 900;
    letter-spacing: -0.025em;
  }

  .lesson-content :global(> h2) {
    margin-top: 1.75rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--pel-secondary-soft);
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    line-height: 1;
    font-weight: 900;
    letter-spacing: -0.02em;
  }

  .lesson-content :global(> h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    line-height: 1.1;
    font-weight: 900;
    letter-spacing: -0.02em;
    border-inline-start: 0.25rem solid var(--pel-secondary);
    padding-inline-start: 0.85rem;
    color: var(--pel-foreground);
  }

  .lesson-content :global(> h4) {
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
    line-height: 1.2;
    font-weight: 800;
    color: var(--pel-secondary);
  }

  .lesson-content :global(> h5) {
    margin-top: 1rem;
    margin-bottom: 0.5rem;
    font-size: 1rem;
    line-height: 1.3;
    font-weight: 800;
    color: var(--pel-foreground);
  }

  .lesson-content :global(> h6) {
    margin-top: 0.75rem;
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
    line-height: 1.4;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--pel-secondary);
  }

  .lesson-content :global(> p:not([class])) {
    margin-block: 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .lesson-content :global(> ul:not([class])) {
    display: grid;
    gap: 0.5rem;
    margin-block: 0.875rem;
    list-style: disc;
    padding-left: 1.5rem;
    line-height: 1.65;
    font-size: 1.0625rem;
  }

  .lesson-content :global(> ol:not([class])) {
    display: grid;
    gap: 0.5rem;
    margin-block: 0.875rem;
    list-style: decimal;
    padding-left: 1.5rem;
    line-height: 1.65;
    font-size: 1.0625rem;
  }

  .lesson-content :global(> ul:not([class]) li::marker),
  .lesson-content :global(> ol:not([class]) li::marker) {
    color: var(--pel-secondary);
    font-weight: 800;
  }
</style>
