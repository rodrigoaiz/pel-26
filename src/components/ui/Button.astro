---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'default' | 'compact';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'default',
  class: className = '',
  type = 'button',
  ...attributes
} = Astro.props;

const Tag = href ? 'a' : 'button';
const variants = {
  primary: 'bg-primary text-on-primary shadow-soft hover:bg-primary-hover hover:-translate-y-0.5',
  secondary: 'bg-secondary text-white hover:bg-secondary/90 hover:-translate-y-0.5',
  ghost: 'border border-border bg-surface text-foreground hover:border-secondary hover:bg-secondary-soft',
};
const sizes = {
  default: 'min-h-12 px-5 py-3 text-sm sm:text-base',
  compact: 'min-h-10 px-3 py-2 text-sm',
};
---

<Tag
  href={href}
  type={href ? undefined : type}
  class:list={[
    'inline-flex items-center justify-center gap-3 rounded-xl font-bold no-underline transition duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-ring',
    variants[variant],
    sizes[size],
    className,
  ]}
  {...attributes}
>
  <slot />
</Tag>
