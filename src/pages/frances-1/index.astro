---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseHeader from '../../components/course/CourseHeader.astro';
import CourseHero from '../../components/course/CourseHero.astro';
import UnitList from '../../components/course/UnitList.astro';
import CourseFooter from '../../components/course/CourseFooter.astro';
import { course } from '../../data/courses/frances-1';
import { getCollection, type CollectionEntry } from 'astro:content';
import { sitePath } from '../../utils/site-path';

const lessonEntries: CollectionEntry<'lessons'>[] = await getCollection('lessons');
const unitTwo = lessonEntries
  .filter((entry) => entry.id.startsWith('frances-1/unidad-2/'))
  .sort((a, b) => a.id.localeCompare(b.id))
  .map((entry, index) => ({
    slug: entry.id.split('/').pop() ?? entry.id,
    ...entry.data,
    status: index === 0 ? 'current' as const : entry.data.status,
    href: sitePath(`frances-1/unidad-2/${entry.id.split('/').pop()}/`)
  }));
---

<BaseLayout>
  <CourseHeader />
  <main>
    <CourseHero />
    <UnitList units={course.units} currentLessons={unitTwo} />
  </main>
  <CourseFooter />
</BaseLayout>
