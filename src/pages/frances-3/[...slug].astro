---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import LessonHeader from '../../components/lesson/LessonHeader.astro';
import LessonIndex from '../../components/lesson/LessonIndex.astro';
import LessonHero from '../../components/lesson/LessonHero.astro';
import LessonFooter from '../../components/lesson/LessonFooter.astro';
import ActivityViewer from '../../components/lesson/ActivityViewer.astro';
import { sitePath } from '../../utils/site-path';

interface Props {
  entry: CollectionEntry<'lessons'>;
}

export async function getStaticPaths() {
  const lessons: CollectionEntry<'lessons'>[] = await getCollection('lessons');
  return lessons
    .filter((entry) => entry.id.startsWith('frances-3/'))
    .map((entry) => ({
      params: { slug: entry.id.replace(/^frances-3\//, '') },
      props: { entry }
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const lessonEntries: CollectionEntry<'lessons'>[] = await getCollection('lessons');
const lessons = lessonEntries
  .filter((item) => item.id.startsWith('frances-3/'))
  .sort((a, b) => a.id.localeCompare(b.id))
  .map((item) => ({
    slug: item.id.split('/').pop() ?? item.id,
    ...item.data,
    href: sitePath(`${item.id}/`)
  }));
const slug = entry.id.split('/').pop() ?? entry.id;
const currentIndex = lessons.findIndex((lesson) => lesson.slug === slug);
const nextLesson = lessons[currentIndex + 1];
const unitLabel = entry.data.unit ?? 'Francés III';
const progressLabel = `Lección ${currentIndex + 1} de ${lessons.length}`;
---

<BaseLayout title={`${entry.data.title} · Francés III`}>
  <main class="min-h-screen bg-background" data-lesson-root>
    <LessonHeader coursePath="frances-3" courseName="Francés III" />
    <LessonIndex
      lessons={lessons}
      currentSlug={slug}
      unitLabel={unitLabel}
      unitTitle={entry.data.unitTitle}
      screens={entry.data.screens}
    />
    <article>
      <LessonHero
        title={entry.data.title}
        unitLabel={unitLabel}
        progressLabel={progressLabel}
        description={entry.data.subtitle}
        firstSectionId={entry.data.firstSectionId}
        phrase="Un projet à venir."
        translation="Una pantalla lista para desarrollar."
      />
      <Content />
      <Container><LessonFooter coursePath="frances-3" nextHref={nextLesson?.href} nextLabel={nextLesson && `Siguiente: ${nextLesson.title}`} /></Container>
    </article>
    <ActivityViewer />
  </main>

  <script>
    import { gsap } from 'gsap';
    const toggle = document.querySelector<HTMLButtonElement>('[data-index-toggle]');
    const panel = document.querySelector<HTMLElement>('[data-index-panel]');
    const backdrop = document.querySelector<HTMLElement>('[data-index-backdrop]');
    const close = document.querySelector<HTMLButtonElement>('[data-index-close]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const setIndex = (open: boolean) => {
      if (!panel || !toggle || !backdrop) return;
      toggle.setAttribute('aria-expanded', String(open)); panel.hidden = !open; backdrop.hidden = !open;
      document.body.classList.toggle('index-open', open);
      if (open) { close?.focus(); if (!reduceMotion) gsap.fromTo(panel, { x: 28, opacity: 0 }, { x: 0, opacity: 1, duration: 0.32, ease: 'power3.out' }); }
      else toggle.focus();
    };
    toggle?.addEventListener('click', () => setIndex(panel?.hidden ?? true));
    close?.addEventListener('click', () => setIndex(false)); backdrop?.addEventListener('click', () => setIndex(false));
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && panel && !panel.hidden) setIndex(false); });
  </script>
</BaseLayout>
