---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseHeader from '../../components/course/CourseHeader.astro';
import Container from '../../components/ui/Container.astro';
import ArrowIcon from '../../components/ui/ArrowIcon.astro';
import { frances3 } from '../../data/courses/frances-3';

export function getStaticPaths() {
  return frances3.units.map((unit) => ({ params: { unit: unit.id }, props: { unit } }));
}

const { unit } = Astro.props;
const base = `${import.meta.env.BASE_URL}frances-3`;
---

<BaseLayout title={`${unit.title} · Francés III`} description={`${unit.title}: índice tentativo de Francés III.`}>
  <CourseHeader courseName={frances3.title} />
  <main class="min-h-screen py-14 sm:py-24">
    <Container>
      <a class="inline-flex items-center gap-2 text-sm font-bold text-primary no-underline hover:text-primary-hover" href={`${base}/`}><ArrowIcon class="rotate-180" /> Volver al índice</a>
      <header class="mt-12 max-w-3xl border-b border-border pb-10">
        <p class="m-0 text-xs font-bold uppercase tracking-[.18em] text-secondary">{frances3.status}</p>
        <h1 class="mt-4 text-6xl font-black leading-display tracking-display sm:text-8xl">{unit.title}</h1>
        <p class="mt-5 text-xl leading-8 text-muted">{unit.theme}</p>
      </header>
      <section class="mt-10 max-w-2xl" aria-labelledby="unit-topics">
        <h2 id="unit-topics" class="text-3xl font-black">Temas por definir</h2>
        <ol class="mt-5 list-none divide-y divide-border border-y border-border p-0">
          {unit.topics.map((topic, index) => <li class="flex items-center gap-4 py-4 text-base"><span class="font-display text-xl font-bold text-secondary">{String(index + 1).padStart(2, '0')}</span><span>{topic}</span></li>)}
        </ol>
        <p class="mt-8 text-sm leading-6 text-muted">Este índice es tentativo. Las actividades, lecturas y enlaces a Moodle se incorporarán cuando se valide el contenido de la unidad.</p>
      </section>
    </Container>
  </main>
</BaseLayout>
