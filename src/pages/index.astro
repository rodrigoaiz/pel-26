---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { sitePath } from '../utils/site-path';
---

<BaseLayout title="Cursos de Francés · PEL" description="Acceso a los cursos de Francés del PEL-UNAM.">
  <main class="min-h-screen py-16 sm:py-24">
    <Container>
      <p class="m-0 text-xs font-bold uppercase tracking-[.18em] text-secondary">PEL · CCH-UNAM</p>
      <h1 class="mt-4 max-w-xl text-6xl font-black leading-display tracking-display sm:text-8xl">Cursos de francés</h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-muted">Elige la asignatura que quieres consultar.</p>
      <nav class="mt-12 grid max-w-2xl gap-4 sm:grid-cols-2" aria-label="Cursos disponibles">
        <a class="rounded-panel bg-navy p-6 text-on-navy no-underline transition hover:-translate-y-1" href={sitePath('frances-1/')}><strong class="block text-3xl font-black">Francés I</strong><span class="mt-3 block text-sm text-on-navy/70">Plan nuevo · piloto disponible</span></a>
        <a class="rounded-panel border border-border bg-surface p-6 text-foreground no-underline transition hover:-translate-y-1" href={sitePath('frances-3/')}><strong class="block text-3xl font-black">Francés III</strong><span class="mt-3 block text-sm text-muted">Plan nuevo · índice tentativo</span></a>
      </nav>
    </Container>
  </main>
</BaseLayout>
