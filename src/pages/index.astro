---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { sitePath } from '../utils/site-path';
import { courses } from '../data/courses';
---

<BaseLayout title="Cursos de Francés · PEL" description="Acceso a los cursos de Francés del PEL-UNAM.">
  <main class="min-h-screen py-16 sm:py-24">
    <Container>
      <p class="m-0 text-xs font-bold uppercase tracking-[.18em] text-secondary">PEL · CCH-UNAM</p>
      <h1 class="mt-4 max-w-xl text-6xl font-black leading-display tracking-display sm:text-8xl">Cursos de francés</h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-muted">Elige la asignatura que quieres consultar.</p>
      <nav class="mt-12 grid max-w-2xl gap-4 sm:grid-cols-2" aria-label="Cursos disponibles">
        {courses.map((course, index) => <a class:list={[
          'rounded-panel p-6 no-underline transition hover:-translate-y-1',
          index === 0 ? 'bg-navy text-on-navy' : 'border border-border bg-surface text-foreground'
        ]} href={sitePath(`${course.slug}/`)}><strong class="block text-3xl font-black">{course.title}</strong><span class:list={['mt-3 block text-sm', index === 0 ? 'text-on-navy/70' : 'text-muted']}>{course.plan} · {course.status}</span></a>)}
      </nav>
    </Container>
  </main>
</BaseLayout>
