---
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseHeader from '../components/course/CourseHeader.astro';
import CourseHero from '../components/course/CourseHero.astro';
import UnitList from '../components/course/UnitList.astro';
import CourseFooter from '../components/course/CourseFooter.astro';
import { course } from '../data/course';
---

<BaseLayout>
  <CourseHeader />
  <main>
    <CourseHero />
    <UnitList units={course.units} currentLessons={course.unitTwo} />
  </main>
  <CourseFooter />
</BaseLayout>
